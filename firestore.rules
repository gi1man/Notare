rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /community_totals/{docId} {
      // Anyone can read aggregate community stats
      allow read: if true;
      // Only authenticated users can write, and only the expected fields
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['category', 'subcategory', 'total_logs', 'total_value', 'updated_at'])
        && request.resource.data.category is string
        && request.resource.data.subcategory is string;
    }
  }
}
